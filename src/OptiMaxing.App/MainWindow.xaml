                                                   HorizontalAlignment="Right" FontFamily="Consolas" />
                                        <TextBlock Grid.Column="4" Text="{Binding ThreadsText}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Style="{StaticResource MutedText}" />
                                        <TextBlock Grid.Column="5" Text="{Binding PriorityText}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Style="{StaticResource MutedText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
