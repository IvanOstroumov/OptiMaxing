                                                           TextTrimming="CharacterEllipsis" />

                                                <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="#3a1e1e"
                                                        Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="критичная" FontSize="11"
                                                               Foreground="{DynamicResource RiskAdvancedBrush}" />
                                                </Border>

                                                <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="#1e3a28"
                                                        Visibility="{Binding IsSafeToDisable, Converter={StaticResource BoolToVisibility}}">
