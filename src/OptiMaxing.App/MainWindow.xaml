                                                               Foreground="{DynamicResource RiskCautionBrush}" />
                                                </Border>

                                                <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" Background="#3a2a1e"
                                                        Visibility="{Binding IsSuspiciousLoad, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Длительная высокая нагрузка на CPU — не обязательно майнер, может быть обычная тяжёлая задача. Реши сам, стоит ли завершать процесс.">
