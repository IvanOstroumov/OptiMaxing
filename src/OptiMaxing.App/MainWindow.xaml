<Window x:Class="OptiMaxing.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OptiMaxing.App"
        Title="OptiMaxing — оптимизация игрового ПК"
        Height="760" Width="1180"
        MinHeight="560" MinWidth="900"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:RiskToBrushConverter x:Key="RiskToBrush" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NullOrEmptyToVisibilityConverter x:Key="TextToVisibility" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="{Binding ThemeToggleText}"
                    Command="{Binding ToggleThemeCommand}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="OptiMaxing" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="каждое изменение записывается в журнал и откатывается"
                           Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Restore point banner -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding RestorePointBanner, Converter={StaticResource TextToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Создать точку восстановления"
                        Command="{Binding CreateRestorePointCommand}" Margin="12,0,0,0" />
                <TextBlock Text="{Binding RestorePointBanner}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="2" Grid.RowSpan="3" Background="Transparent" BorderThickness="0">
            <TabItem Header="Здоровье системы" DataContext="{Binding Health}"
                     IsSelected="{Binding IsActive, Mode=OneWayToSource}">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCommand}" />
                            <TextBlock Text="Снимок системы на момент запуска" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource RiskCautionBrush}" BorderThickness="1"
                                Padding="14,10" Margin="0,0,0,12"
                                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Стоит обратить внимание" FontWeight="SemiBold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource RiskCautionBrush}" />
                                <ItemsControl ItemsSource="{Binding Warnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"
                                                       Foreground="{DynamicResource RiskCautionBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="14,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding OsDescription}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding ProcessorName}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                           Text="{Binding UptimeText, StringFormat='Время работы: {0}'}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="14,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Безопасность" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding SecurityRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource MutedText}" />
                                                <TextBlock Grid.Column="1" Text="{Binding ValueText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConcern}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource RiskCautionBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="14,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Оперативная память" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding MemoryUsedPercent, Mode=OneWay}"
                                             Foreground="{DynamicResource AccentBrush}" Background="#0f1622" BorderThickness="0" />
                                <TextBlock Text="{Binding MemorySummary}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Диски" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Disks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                <ProgressBar Height="6" Minimum="0" Maximum="100"
                                                             Value="{Binding FreePercent, Mode=OneWay}"
                                                             Background="#0f1622" BorderThickness="0" Margin="0,4,0,0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource RiskCautionBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="14,10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Железо" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding HardwareFacts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="14,10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Датчики в реальном времени" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding SensorStatus}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource RiskCautionBrush}" Margin="0,0,0,6"
                                           Visibility="{Binding HasSensorProblem, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding SensorGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,4" />
                                                <ItemsControl ItemsSource="{Binding Sensors}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="110" />
                                                                    <ColumnDefinition Width="110" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                           Style="{StaticResource MutedText}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                           HorizontalAlignment="Right" FontFamily="Consolas" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Max}"
                                                                           HorizontalAlignment="Right" FontFamily="Consolas"
                                                                           Style="{StaticResource MutedText}"
                                                                           ToolTip="Максимум за сессию" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Твики">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 ToolTip="Поиск по названию, описанию и категории" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="Пресет: безопасные" Command="{Binding SelectSafePresetCommand}"
                                    ToolTip="Все твики с уровнем риска «безопасно»" />
                            <Button Content="Пресет: производительность" Command="{Binding SelectPerformancePresetCommand}"
                                    Margin="8,0,0,0"
                                    ToolTip="Электропитание, видеокарта, диски, сеть, автозагрузка, службы — без продвинутых твиков" />
                            <Button Content="Пресет: приватность" Command="{Binding SelectPrivacyPresetCommand}"
                                    Margin="8,0,0,0" ToolTip="Всё из категории «Приватность»" />
                            <Button Content="Пресет: чистка" Command="{Binding SelectCleanupPresetCommand}"
                                    Margin="8,0,0,0" ToolTip="Bloatware и очистка диска" />
                            <Button Content="Снять выделение" Command="{Binding ClearSelectionCommand}" Margin="8,0,0,0" />
                            <Button Content="Обновить состояние" Command="{Binding ScanCommand}" Margin="8,0,0,0" />
                            <Button Content="Экспорт набора…" Command="{Binding ExportPresetCommand}" Margin="16,0,0,0"
                                    ToolTip="Сохранить текущий выбор твиков в JSON-файл" />
                            <Button Content="Импорт набора…" Command="{Binding ImportPresetCommand}" Margin="8,0,0,0"
                                    ToolTip="Загрузить выбор твиков из ранее сохранённого JSON-файла" />
                        </StackPanel>
                    </Grid>

                    <!-- Content -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Category tree (flat — the catalog has no sub-categories, so a single-level
                             list with counts gives the same navigation value as a real tree) -->
                        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6">
                            <ListBox ItemsSource="{Binding CategoryEntries}" Background="Transparent" BorderThickness="0"
                                     SelectedValuePath="Name" SelectedValue="{Binding SelectedCategory}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bg" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                            Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#1a2433" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#1e3a5f" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="6,1"
                                                    Background="#0f1622" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count}" FontSize="11"
                                                           Style="{StaticResource MutedText}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <!-- ScrollUnit=Pixel keeps virtualization (these lists grow to hundreds of
                                 rows) while scrolling by pixels instead of by whole cards — with the
                                 default item-based scrolling one wheel tick skipped an entire tweak. -->
                            <ListBox ItemsSource="{Binding Visible}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- A ToggleButton, not a plain Border, so that clicking anywhere on the
                                             card toggles the tweak instead of only the small checkbox hit area.
                                             The template strips all button chrome; the CheckBox inside is a
                                             non-interactive indicator so it cannot fight the parent for clicks. -->
                                        <ToggleButton IsChecked="{Binding IsSelected}" Cursor="Hand"
                                                      HorizontalContentAlignment="Stretch" Background="Transparent">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid Margin="4">
                                                        <Border x:Name="Card" CornerRadius="6" Background="Transparent"
                                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" />
                                                        <Border x:Name="Accent" Width="3" HorizontalAlignment="Left"
                                                                CornerRadius="2" Background="Transparent" Margin="0,2" />
                                                        <ContentPresenter Margin="12,10" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Card" Property="Background" Value="#1a2433" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Card" Property="Background" Value="#1e3a5f" />
                                                            <Setter TargetName="Accent" Property="Background"
                                                                    Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                          IsHitTestVisible="False" Focusable="False"
                                                          VerticalAlignment="Top" Margin="0,2,12,0" />

                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />

                                                        <Border CornerRadius="4" Padding="6,1" Margin="10,0,0,0"
                                                                Background="#1e2a3a">
                                                            <TextBlock Text="{Binding RiskText}" FontSize="11"
                                                                       Foreground="{Binding Risk, Converter={StaticResource RiskToBrush}}" />
                                                        </Border>

                                                        <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" Background="#1e2a3a">
                                                            <TextBlock Text="{Binding ReversibilityText}" FontSize="11"
                                                                       Style="{StaticResource MutedText}" />
                                                        </Border>

                                                        <TextBlock Text="перезагрузка" FontSize="11" Margin="6,0,0,0"
                                                                   Style="{StaticResource MutedText}"
                                                                   Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                                               Margin="0,4,0,0" />

                                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                                               Foreground="{DynamicResource RiskCautionBrush}"
                                                               Text="{Binding TradeOff, StringFormat='Цена: {0}'}"
                                                               Visibility="{Binding TradeOff, Converter={StaticResource TextToVisibility}}" />

                                                    <StackPanel Margin="0,8,0,0"
                                                                Visibility="{Binding HasChoices, Converter={StaticResource BoolToVisibility}}">
                                                        <ComboBox ItemsSource="{Binding Choices}"
                                                                  SelectedItem="{Binding SelectedChoice}"
                                                                  DisplayMemberPath="DisplayName"
                                                                  HorizontalAlignment="Left" MinWidth="360" />

                                                        <TextBlock Text="{Binding SelectedChoice.Description}"
                                                                   Style="{StaticResource MutedText}"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                                                        <TextBlock Text="{Binding CurrentValueText}" FontSize="11"
                                                                   Margin="0,4,0,0" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding StateText}" FontSize="11"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                        <TextBlock Text="— настройка задана другим инструментом" FontSize="11"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource RiskCautionBrush}"
                                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Журнал" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource MutedTextBrush}"
                                         FontFamily="Consolas" FontSize="12" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Footer -->
                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Откатить выбранное" Command="{Binding RevertCommand}" />
                            <Button Content="Применить выбранное" Command="{Binding ApplyCommand}"
                                    Style="{StaticResource AccentButton}" Margin="10,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar Width="140" Height="4" IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentBrush}" Background="Transparent"
                                         BorderThickness="0" Margin="0,0,10,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Автозапуск" DataContext="{Binding Startup}">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Обновить" Command="{Binding RefreshCommand}" />
                            <Button Content="{Binding Selected.ToggleText, FallbackValue='Отключить'}"
                                    Command="{Binding ToggleCommand}" Margin="8,0,0,0" />
                            <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}"
                                 Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid Margin="4">
                                                    <Border x:Name="Bg" CornerRadius="6" Background="Transparent"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" />
                                                    <Border x:Name="Accent" Width="3" HorizontalAlignment="Left"
                                                            CornerRadius="2" Background="Transparent" Margin="0,2" />
                                                    <ContentPresenter Margin="12,10" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#1a2433" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#1e3a5f" />
                                                        <Setter TargetName="Accent" Property="Background"
                                                                Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />

                                            <Border CornerRadius="4" Padding="6,1" Margin="10,0,0,0" Background="#1e2a3a">
                                                <TextBlock Text="{Binding StateText}" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" Background="#3a1e1e"
                                                    Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="системное" FontSize="11"
                                                           Foreground="{DynamicResource RiskAdvancedBrush}" />
