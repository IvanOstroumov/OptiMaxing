                                                           Style="{StaticResource MutedText}" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />

                                                <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" Background="#3a1e1e"
                                                        Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="системный" FontSize="11"
                                                               Foreground="{DynamicResource RiskAdvancedBrush}" />
                                                </Border>

                                                <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" Background="#3a3320"
                                                        Visibility="{Binding IsHung, Converter={StaticResource BoolToVisibility}}">
