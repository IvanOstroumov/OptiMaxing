<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>OptiMaxing</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <!-- WPF single-file publishing requires native libs to be extracted at runtime;
         without this the exe fails to start. Verified by publish spike. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>

    <!-- installer/OptiMaxing.iss reads the exe from repo-root publish/; without this,
         dotnet publish's default bin/.../publish/ output silently diverges from what
         the installer ships, so a stale copy there gets packaged instead. -->
    <PublishDir>$(MSBuildThisFileDirectory)..\..\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptiMaxing.Core\OptiMaxing.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MainWindow.xaml's Icon="Resources/app.ico" resolves via pack URI at runtime, which
         requires the file to be embedded as a WPF Resource, not just used as ApplicationIcon
         (that only sets the exe's Win32 icon at compile time). -->
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
