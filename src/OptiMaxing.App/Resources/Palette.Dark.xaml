<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundColor">#0b0f14</Color>
    <Color x:Key="PanelColor">#151e2b</Color>
    <Color x:Key="AccentColor">#5ee6c5</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="#e6edf5" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8ea0b5" />
    <SolidColorBrush x:Key="BorderBrush" Color="#243244" />

    <SolidColorBrush x:Key="RiskSafeBrush" Color="#5ee6c5" />
    <SolidColorBrush x:Key="RiskCautionBrush" Color="#ffd166" />
    <SolidColorBrush x:Key="RiskAdvancedBrush" Color="#ff6b6b" />
    <SolidColorBrush x:Key="RiskAdvisoryBrush" Color="#7aa7ff" />

</ResourceDictionary>
