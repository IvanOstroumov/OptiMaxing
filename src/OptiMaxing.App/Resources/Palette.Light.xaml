<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundColor">#f2f4f7</Color>
    <Color x:Key="PanelColor">#ffffff</Color>
    <Color x:Key="AccentColor">#0f9d78</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="#1a2230" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5b6b80" />
    <SolidColorBrush x:Key="BorderBrush" Color="#d7dee6" />

    <SolidColorBrush x:Key="RiskSafeBrush" Color="#0f9d78" />
    <SolidColorBrush x:Key="RiskCautionBrush" Color="#a66a00" />
    <SolidColorBrush x:Key="RiskAdvancedBrush" Color="#c9463c" />
    <SolidColorBrush x:Key="RiskAdvisoryBrush" Color="#3a66cc" />

</ResourceDictionary>
